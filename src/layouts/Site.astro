---
import '../styles/site.css';
import '../styles/lab.css';
import '../styles/theme.css';
const { title = 'Decision Science and Analytics', description = 'Abdulaziz Aldoseri — decision modelling, operations research and analytical advisory experience.', wide = false, noindex = false, home = false } = Astro.props;
const route = Astro.url.pathname;
const canonicalPath = route === '/404/' || route === '/404' || route === '/404.html' ? '/404.html' : route.endsWith('/') ? route : route + '/';
const canonical = new URL(canonicalPath, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Abdulaziz Aldoseri</title>
  <meta name="description" content={description} /><link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={`${title} | Abdulaziz Aldoseri`} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#0b3439" /><link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
</head>
<body class:list={[{ 'home-site': home }]}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header"><div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Abdulaziz Aldoseri home"><span class="monogram" aria-hidden="true">AA<span>.</span></span><span>Abdulaziz<br />Aldoseri</span></a>
    <nav aria-label="Main navigation"><a href="/projects/">Decision Lab</a><a href={route === '/' ? '#contact' : '/#contact'}>Contact</a><a href="/files/Abdulaziz_Aldoseri_CV.pdf" download aria-label="Download CV (PDF)">CV <span aria-hidden="true">↗</span></a></nav>
  </div></header>
  <main id="main" class:list={[{ wide }]}><slot /></main>
  <slot name="footer"><footer class="site-footer"><div class="shell footer-inner"><p>Bahrain</p><div class="footer-links"><a href="https://www.linkedin.com/in/abdulaziz-aldoseri/">LinkedIn</a><a href="https://github.com/Abdulaziz-Aldoseri">GitHub</a></div></div></footer></slot>
</body>
</html>
