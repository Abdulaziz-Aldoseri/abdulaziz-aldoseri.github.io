---
interface Props { id: string; title: string; class?: string; items: { label: string; text: string }[] }
const { id, title, items, class: className = '' } = Astro.props;
---
<section class:list={['shell', 'model-brief', className]} aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  <dl class="model-contract">{items.map(item => <div><dt>{item.label}</dt><dd>{item.text}</dd></div>)}</dl>
  <slot />
</section>
